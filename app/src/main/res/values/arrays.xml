<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 时钟对齐位置 -->
    <string-array name="clock_position_entries">
        <item>左侧 (默认 One UI 位置)</item>
        <item>居中显示</item>
        <item>右侧显示</item>
    </string-array>
    <string-array name="clock_position_values">
        <item>left</item>
        <item>center</item>
        <item>right</item>
    </string-array>

    <!-- 格式化模式 -->
    <string-array name="format_mode_entries">
        <item>智能预设 (时间 + 日期 + 农历/天气)</item>
